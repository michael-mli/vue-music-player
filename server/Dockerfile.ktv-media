FROM livekit/livekit-server:v1.13.7@sha256:6fd3b7088874c4d119160dd688798dfec852bc014786d392caad15f6f63912a3 AS livekit
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
WORKDIR /opt/ktv-media
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=livekit /livekit-server /usr/local/bin/livekit-server
COPY server/ktv-media-gateway.js server/ktv-media-worker.js server/ktv-media-supervisor.js ./
USER node
ENTRYPOINT ["node", "ktv-media-supervisor.js"]
