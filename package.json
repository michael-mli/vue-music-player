{
  "name": "mics-music-player",
  "version": "1.0.0",
  "description": "Modern Vue.js music player with PWA support",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test:lyrics": "node --test scripts/lyrics-timing.test.mjs",
    "test:party": "node --test scripts/party-clock.test.mjs scripts/party-audio.test.mjs scripts/party-commands.test.mjs scripts/party-publish.test.mjs scripts/party-capture.test.mjs scripts/party-media-lifecycle.test.mjs scripts/party-media-config.test.mjs",
    "test:party:browser": "node scripts/party-browser.test.mjs",
    "test:party:ui": "node scripts/party-ui-browser.test.mjs",
    "test:party:load": "node scripts/party-load.test.mjs",
    "test:party:tls": "node --test scripts/party-media-tls.test.mjs",
    "test:party:pwa": "node scripts/party-pwa-browser.test.mjs",
    "test:party:media": "node scripts/party-media-browser.test.mjs",
    "test:party:supervisor": "node scripts/party-media-supervisor.test.mjs",
    "test:party:public-transport": "node scripts/party-public-transport.test.mjs",
    "test:party:room-media": "node scripts/party-room-media-browser.test.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@headlessui/vue": "^1.7.16",
    "@heroicons/vue": "^2.0.18",
    "axios": "^1.6.2",
    "livekit-client": "2.22.3",
    "opencc-js": "^1.4.1",
    "pinia": "^2.1.7",
    "qrcode": "1.5.4",
    "vue": "^3.4.0",
    "vue-i18n": "^9.8.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vue/tsconfig": "^0.5.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "~5.3.0",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^0.17.4",
    "vite-plugin-static-copy": "^3.1.1",
    "vue-tsc": "^1.8.25",
    "workbox-window": "^7.0.0"
  }
}
